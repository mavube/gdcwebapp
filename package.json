{
  "name": "gdc-web-app",
  "description": "Corporate front-end for Global Dynamics Consulting",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i assets/styles/app.css -o public/build/app.css --minify",
    "watch:css": "tailwindcss -i assets/styles/app.css -o public/build/app.css --watch",
    "build:js": "node -e \"const fs=require('fs');fs.mkdirSync('public/build',{recursive:true});fs.copyFileSync('assets/funnel.js','public/build/funnel.js');fs.copyFileSync('assets/site.js','public/build/site.js')\"",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
