<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Global Dynamics Consulting{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset("build/app.css") }}">
</head>
<body class="min-h-screen bg-canvas font-sans text-navy antialiased">

    {# ---- 1. Global layout frame: floating nav over the warm surface ---- #}
    <header class="sticky top-0 z-50 border-b border-navy/10 bg-canvas/85 backdrop-blur-md">
        <div class="ui-container flex h-20 items-center justify-between">
            <a href="{{ path("app_home") }}" class="font-heading text-lg font-bold tracking-tight text-navy">
                Global Dynamics<span class="text-regal">.</span>
            </a>
            <a href="#inquiry" data-funnel-open
               class="ui-button ui-button-primary">
                Request Briefing
            </a>
        </div>
    </header>

    <main class="ui-container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div role="status" class="mt-6 rounded-field border px-5 py-4 text-sm
                     {{ label == "success" ? "border-ok/30 bg-ok/5 text-ok" : "border-danger/30 bg-danger/5 text-danger" }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="mt-24 border-t border-navy/10 bg-cream">
        <div class="ui-container flex flex-col gap-4 py-12 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
            <p class="font-heading text-base font-bold text-navy">
                Global Dynamics<span class="text-regal">.</span>
            </p>
            <p class="text-xs tracking-wide">
                &copy; {{ "now"|date("Y") }} Global Dynamics Consulting
            </p>
        </div>
    </footer>

    {# ---- Conversion deck: present on every public page, opened on demand ---- #}
    {% include "_partials/_funnel_deck.html.twig" %}
    <script src="{{ asset("build/funnel.js") }}" defer></script>
</body>
</html>
