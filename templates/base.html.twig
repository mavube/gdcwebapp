<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Global Dynamics Consulting{% endblock %}</title>
    <meta name="description" content="{% block description %}PMP certification training, project management tool mastery and enterprise strategy consulting from Global Dynamics Consulting, Dar es Salaam.{% endblock %}">
    <link rel="icon" href="{{ asset("images/favicon.svg") }}" type="image/svg+xml">
    {# Self-hosted fonts are declared in app.css; preload the two latin faces so
       the first paint does not wait on the stylesheet parse. #}
    <link rel="preload" href="{{ asset("fonts/plus-jakarta-sans-400-latin.woff2") }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset("fonts/manrope-400-latin.woff2") }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset("build/app.css") }}">
</head>
<body class="flex min-h-screen flex-col bg-surface font-sans text-brand-ink antialiased">

    {# ---- 1. Global layout frame ----
       A floating bar: transparent over the top of the page, then solid with a
       hairline once the page is scrolled. The toggle is driven by a class the
       script below sets, so the bar is fully styled and legible without
       JavaScript: the default is the solid state. #}
    <header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-surface/0 transition-colors duration-300">
        <div class="ui-container flex h-20 items-center justify-between gap-6">
            <a href="{{ path("app_home") }}" class="flex shrink-0 items-center gap-3" aria-label="Global Dynamics Consulting, home">
                {# The brand mark. The uploaded asset is a white knockout, so it is
                   only legible on the dark band; on the light header we render the
                   wordmark instead. Drop a coloured mark at images/gdc-logo.svg and
                   this switches to it automatically. #}
                {% if gdc_logo_available() %}
                    <img src="{{ asset("images/gdc-logo.svg") }}" alt="Global Dynamics Consulting" class="h-9 w-auto">
                {% else %}
                    <span class="font-heading text-lg font-extrabold tracking-tight text-brand-ink">
                        Global Dynamics<span class="text-accent">.</span>
                    </span>
                    <span class="hidden text-[0.6875rem] font-semibold uppercase tracking-widest text-muted sm:block">
                        Consulting
                    </span>
                {% endif %}
            </a>

            <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
                {% for link in gdc_site_items('site.nav') %}
                    {% set href = gdc_link(link.linkTarget) %}
                    {% if href %}
                        <a href="{{ href }}" class="text-sm font-medium text-muted transition-colors hover:text-brand"
                           {% if gdc_is_external(link.linkTarget) %}target="_blank" rel="noreferrer"{% endif %}>{{ link.title }}</a>
                    {% endif %}
                {% endfor %}
            </nav>

            <div class="flex items-center gap-3">
                {% set phone = null %}
                {% for channel in gdc_site_items('site.contact') %}
                    {% if phone is null and channel.linkTarget and channel.linkTarget starts with 'tel:' %}
                        {% set phone = channel %}
                    {% endif %}
                {% endfor %}
                {% if phone %}
                    <a href="{{ phone.linkTarget }}" class="hidden text-sm font-semibold text-brand-ink transition-colors hover:text-brand md:block">
                        {{ phone.subtitle }}
                    </a>
                {% endif %}
                <button type="button" data-funnel-open class="ui-button ui-button-primary">
                    {{ gdc_site_block('site.header.cta').ctaLabel|default('Request briefing') }}
                </button>
            </div>
        </div>
    </header>

    <main class="flex-1">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="ui-container">
                    <div role="status" class="mt-6 rounded-field border px-5 py-4 text-sm
                         {{ label == "success" ? "border-ok/30 bg-ok/5 text-ok" : "border-danger/30 bg-danger/5 text-danger" }}">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    {# ---- Footer: the dark band, where the white knockout mark is legible ----
       Every string comes from the admin: the blurb from a block, the link
       columns and the legal line from content rows. A column with no rows is
       omitted rather than rendered as an empty heading. #}
    <footer class="ui-band-ink mt-24">
        <div class="ui-container grid grid-cols-1 gap-12 py-16 md:grid-cols-4">
            <div class="md:col-span-2">
                <img src="{{ asset("images/gdc-logo-white.png") }}" alt="Global Dynamics Consulting" class="h-10 w-auto">
                {% set blurb = gdc_site_block('site.footer.blurb') %}
                {% if blurb and blurb.body %}
                    <p class="mt-5 max-w-measure text-sm leading-relaxed text-surface/70">{{ blurb.body }}</p>
                {% endif %}
            </div>

            {% set footerLinks = gdc_site_items('site.footer.links') %}
            {% if footerLinks|length > 0 %}
                <div>
                    <p class="text-label font-semibold uppercase tracking-widest text-surface/60">Company</p>
                    <ul class="mt-5 space-y-3 text-sm">
                        {% for link in footerLinks %}
                            {% set href = gdc_link(link.linkTarget) %}
                            {% if href %}
                                <li>
                                    <a href="{{ href }}" class="text-surface/80 transition-colors hover:text-accent"
                                       {% if gdc_is_external(link.linkTarget) %}target="_blank" rel="noreferrer"{% endif %}>{{ link.title }}</a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% set contact = gdc_site_items('site.contact') %}
            {% if contact|length > 0 %}
                <div>
                    <p class="text-label font-semibold uppercase tracking-widest text-surface/60">Contact</p>
                    <ul class="mt-5 space-y-3 text-sm text-surface/80">
                        {% for channel in contact %}
                            <li>
                                {% set channelHref = gdc_link(channel.linkTarget) %}
                                {% if channelHref %}
                                    <a href="{{ channelHref }}" class="transition-colors hover:text-accent">{{ channel.subtitle }}</a>
                                {% else %}
                                    {{ channel.subtitle }}
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>

        <div class="border-t border-surface/15">
            <div class="ui-container flex flex-col gap-3 py-6 text-xs text-surface/60 sm:flex-row sm:items-center sm:justify-between">
                {% set legal = gdc_site_items('site.legal') %}
                {% if legal|length > 0 %}
                    {% for line in legal %}
                        <p>
                            {{ line.body }}
                            {% if line.linkLabel and line.linkTarget %}
                                <a href="{{ gdc_link(line.linkTarget) }}" class="transition-colors hover:text-accent"
                                   {% if gdc_is_external(line.linkTarget) %}target="_blank" rel="noreferrer"{% endif %}>{{ line.linkLabel }}</a>
                            {% endif %}
                        </p>
                    {% endfor %}
                {% else %}
                    <p>&copy; {{ "now"|date("Y") }} Global Dynamics Consulting. All rights reserved.</p>
                {% endif %}
            </div>
        </div>
    </footer>

    {# ---- Conversion deck: present on every public page, opened on demand ---- #}
    {% include "_partials/_funnel_deck.html.twig" with {deckService: deckService|default(null)} only %}

    {# The deck's configuration, serialised for the controller. A JSON script
       block rather than an inline script, so it needs no CSP exception.
       JSON_HEX_TAG escapes "<" and ">", without which admin-supplied copy
       containing "</script>" would close this block and inject markup. #}
    <script id="funnel-config" type="application/json">{{ gdc_funnel_config(deckService|default(null))|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
    <script src="{{ asset("build/site.js") }}" defer></script>
    <script src="{{ asset("build/funnel.js") }}" defer></script>
</body>
</html>
