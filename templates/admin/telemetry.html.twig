{#
    Internal telemetry command centre.

    Deliberately standalone rather than extending base.html.twig: the admin
    surface must be unmistakably distinct from the corporate front-end, and the
    slate canvas must cover the whole viewport without inheriting the light
    shell's header, footer or flash block.
#}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Telemetry · GDC Command Centre{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset("build/app.css") }}">
</head>
<body class="min-h-screen bg-[#0F172A] font-sans text-slate-200 antialiased">

    <header class="border-b border-slate-700/50 bg-[#0F172A]">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
            <div class="flex items-center gap-3">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                <span class="text-sm font-semibold tracking-tight text-white">GDC Command Centre</span>
                <span class="rounded border border-slate-700 px-2 py-0.5 text-[10px] uppercase tracking-wider text-slate-400">
                    Internal
                </span>
            </div>
            <div class="flex items-center gap-4">
                <span class="hidden text-xs text-slate-400 sm:inline">{{ app.user.userIdentifier }}</span>
                <a href="{{ path("app_admin_logout") }}"
                   class="rounded-md border border-slate-700 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:border-slate-500 hover:text-white">
                    Sign out
                </a>
            </div>
        </div>
    </header>

    <main class="mx-auto w-full max-w-7xl px-6 py-10">

        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-white">Conversion telemetry</h1>
                <p class="mt-1 text-sm text-slate-400">
                    Inbound corporate briefing requests, newest first.
                </p>
            </div>
            <p class="text-xs text-slate-500">
                Generated {{ "now"|date("Y-m-d H:i:s T") }}
            </p>
        </div>

        {# ---- Executive indicator matrix: three modules locked horizontally ---- #}
        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">

            <div class="rounded-lg border border-slate-700/50 bg-slate-800/40 p-6">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pending Inquiries</p>
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-sky-400/10 text-sky-300">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M6 3.5V6l2 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </span>
                </div>
                <p class="mt-4 text-3xl font-bold tracking-tight text-white">{{ metrics.pending }}</p>
                <p class="mt-1 text-xs text-slate-500">Active, unaddressed B2B quote operations</p>
            </div>

            <div class="rounded-lg border border-slate-700/50 bg-slate-800/40 p-6">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Scheduled Corporate Briefings</p>
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-amber-400/10 text-amber-300">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <rect x="1.5" y="2.5" width="9" height="8" rx="1.25" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M1.5 5h9M4 1.5v2M8 1.5v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </span>
                </div>
                <p class="mt-4 text-3xl font-bold tracking-tight text-white">{{ metrics.scheduled }}</p>
                <p class="mt-1 text-xs text-slate-500">Confirmed consultative slots locked in</p>
            </div>

            <div class="rounded-lg border border-slate-700/50 bg-slate-800/40 p-6">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pipeline Revenue Valuation</p>
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-400/10 text-emerald-300">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M1.5 9.5l3-3.5 2 2 3.5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </div>
                <p class="mt-4 text-3xl font-bold tracking-tight text-white">
                    ${{ metrics.pipelineUsd|number_format(0, ".", ",") }}
                </p>
                <p class="mt-1 text-xs text-slate-500">Financial matrix mapped from corporate tiers</p>
            </div>
        </div>

        {# ---- Inbound data grid ---- #}
        <section class="mt-10">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Inbound data grid</h2>
                <span class="text-xs text-slate-500">{{ leads|length }} record{{ leads|length == 1 ? "" : "s" }}</span>
            </div>

            {% if leads is empty %}
                <div class="mt-4 rounded-lg border border-dashed border-slate-700 p-12 text-center">
                    <p class="text-sm text-slate-400">No inbound leads yet.</p>
                    <p class="mt-1 text-xs text-slate-500">Submissions from the conversion deck appear here immediately.</p>
                </div>
            {% else %}
                <div class="mt-4 overflow-x-auto rounded-lg border border-slate-700/50">
                    <table class="w-full min-w-[900px] border-collapse text-left">
                        <thead>
                            <tr class="border-b border-slate-700/50 bg-slate-800/60">
                                <th scope="col" class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-400">Organization Identity</th>
                                <th scope="col" class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-400">Conversion Intent Tier</th>
                                <th scope="col" class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-400">Submission Timestamp</th>
                                <th scope="col" class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-400">Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for lead in leads %}
                                <tr class="border-b border-slate-700/30 transition-colors last:border-b-0 hover:bg-slate-800/40">
                                    {# Organization identity: company, contact and reachability #}
                                    <td class="px-6 py-6 align-top">
                                        <p class="text-sm font-semibold text-white">
                                            {{ lead.companyName ?: "Unspecified organization" }}
                                        </p>
                                        <p class="mt-1 text-xs text-slate-400">{{ lead.fullName }}</p>
                                        <p class="mt-0.5 text-xs text-slate-500">{{ lead.email }}</p>
                                        {% if lead.organizationScope %}
                                            <p class="mt-1 text-xs text-slate-500">{{ lead.organizationScope }}</p>
                                        {% endif %}
                                    </td>

                                    {# Intent tier, with the indicative pipeline value #}
                                    <td class="px-6 py-6 align-top">
                                        {% if lead.intentTier %}
                                            <p class="text-sm text-slate-200">{{ lead.intentTier.shortLabel }}</p>
                                            <p class="mt-1 text-xs text-slate-500">
                                                ${{ (lead.estimatedValueUsd ?? 0)|number_format(0, ".", ",") }} indicative
                                            </p>
                                        {% else %}
                                            <p class="text-sm text-slate-500">—</p>
                                        {% endif %}
                                    </td>

                                    {# Timestamp: rendered in the server timezone so the
                                       dashboard never disagrees with stored values. #}
                                    <td class="px-6 py-6 align-top">
                                        <time datetime="{{ lead.createdAt|date("c") }}" class="text-sm text-slate-200">
                                            {{ lead.createdAt|date("Y-m-d") }}
                                        </time>
                                        <p class="mt-1 text-xs text-slate-500">
                                            {{ lead.createdAt|date("H:i:s") }} {{ lead.createdAt|date("T") }}
                                        </p>
                                        <p class="mt-0.5 text-xs text-slate-600">
                                            {{ lead.createdAt|date("Y-m-d H:i:s") }}
                                        </p>
                                    </td>

                                    {# Functional progress badge #}
                                    <td class="px-6 py-6 align-top">
                                        <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold {{ lead.status.badgeClasses }}">
                                            {{ lead.status.label }}
                                        </span>
                                        {% if lead.trainingProgram %}
                                            <p class="mt-2 text-xs text-slate-500">{{ lead.trainingProgram.title }}</p>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </main>
</body>
</html>
