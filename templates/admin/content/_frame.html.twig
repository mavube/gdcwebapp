{#
    Shared frame for the admin content forms.

    The admin is deliberately standalone rather than extending base.html.twig,
    so this partial carries the head, the header bar and the flash block, and
    the form templates extend it. Keeps the three admin pages looking alike
    without each repeating the shell.
#}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Content · GDC Command Centre{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset("build/app.css") }}">
</head>
<body class="min-h-screen bg-[#0F172A] font-sans text-slate-200 antialiased">

    <header class="border-b border-slate-700/50 bg-[#0F172A]">
        <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6">
            <div class="flex items-center gap-3">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                <span class="text-sm font-semibold tracking-tight text-white">GDC Command Centre</span>
                <span class="rounded border border-slate-700 px-2 py-0.5 text-[10px] uppercase tracking-wider text-slate-400">
                    Content
                </span>
            </div>
            <a href="{{ path("app_admin_content_index") }}" class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">
                Back to content
            </a>
        </div>
    </header>

    <main class="mx-auto w-full max-w-3xl px-6 py-10">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div role="status" class="mb-6 rounded-lg border px-5 py-4 text-sm
                     {{ label == "success" ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-200" : "border-red-500/30 bg-red-500/10 text-red-200" }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block form %}{% endblock %}
    </main>
</body>
</html>
