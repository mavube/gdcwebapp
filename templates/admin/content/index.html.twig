{#
    Content editor: the index.

    Two lists, matching the two entities the public pages read: the named
    sections, and the rows inside each repeatable list. Both are grouped the
    same way so an editor can see, at a glance, which parts of the site have
    content and which are still waiting for it.

    Deliberately standalone rather than extending base.html.twig, as the
    telemetry dashboard is: the admin surface must be unmistakably distinct from
    the corporate front-end.
#}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Content · GDC Command Centre</title>
    <link rel="stylesheet" href="{{ asset("build/app.css") }}">
</head>
<body class="min-h-screen bg-[#0F172A] font-sans text-slate-200 antialiased">

    <header class="border-b border-slate-700/50 bg-[#0F172A]">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
            <div class="flex items-center gap-3">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                <span class="text-sm font-semibold tracking-tight text-white">GDC Command Centre</span>
                <span class="rounded border border-slate-700 px-2 py-0.5 text-[10px] uppercase tracking-wider text-slate-400">
                    Content
                </span>
            </div>
            <div class="flex items-center gap-4">
                <a href="{{ path("app_admin_telemetry") }}" class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">
                    Telemetry
                </a>
                <span class="hidden text-xs text-slate-400 sm:inline">{{ app.user.userIdentifier }}</span>
                <a href="{{ path("app_admin_logout") }}"
                   class="rounded-md border border-slate-700 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:border-slate-500 hover:text-white">
                    Sign out
                </a>
            </div>
        </div>
    </header>

    <main class="mx-auto w-full max-w-7xl px-6 py-10">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div role="status" class="mb-6 rounded-lg border px-5 py-4 text-sm
                     {{ label == "success" ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-200" : "border-red-500/30 bg-red-500/10 text-red-200" }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-white">Content</h1>
                <p class="mt-1 text-sm text-slate-400">
                    Every string the public site shows is edited here. Nothing is hard-coded in a template.
                </p>
            </div>
            <a href="{{ path("app_admin_content_block_new") }}"
               class="rounded-md bg-sky-500 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-sky-400">
                New section
            </a>
        </div>

        {# ---- Named sections ---- #}
        <section class="mt-10">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400">
                Sections
                <span class="ml-2 font-normal normal-case tracking-normal text-slate-500">{{ blocks|length }}</span>
            </h2>

            <div class="mt-4 overflow-x-auto rounded-lg border border-slate-700/50">
                <table class="w-full min-w-[760px] border-collapse text-left">
                    <thead>
                        <tr class="border-b border-slate-700/50 bg-slate-800/60">
                            <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Key</th>
                            <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Heading</th>
                            <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">State</th>
                            <th scope="col" class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-400">Edit</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for block in blocks %}
                            <tr class="border-b border-slate-700/40 last:border-0">
                                <td class="px-5 py-3 font-mono text-xs text-slate-400">{{ block.blockKey }}</td>
                                <td class="px-5 py-3">
                                    <p class="text-sm font-medium text-white">{{ block.heading|default(block.label) }}</p>
                                    <p class="mt-0.5 text-xs text-slate-500">{{ block.label }}</p>
                                </td>
                                <td class="px-5 py-3">
                                    {% if block.active %}
                                        <span class="rounded-full bg-emerald-500/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-emerald-300">Live</span>
                                    {% else %}
                                        <span class="rounded-full bg-slate-600/20 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Hidden</span>
                                    {% endif %}
                                </td>
                                <td class="px-5 py-3 text-right">
                                    <a href="{{ path("app_admin_content_block_edit", {id: block.id}) }}"
                                       class="text-xs font-semibold text-sky-400 transition-colors hover:text-sky-300">Edit</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        {# ---- Repeatable rows, grouped by section ---- #}
        <section class="mt-12">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Lists</h2>
            <p class="mt-1 text-sm text-slate-400">
                A list with no rows is simply not shown on the page, so an empty section is never a broken one.
            </p>

            <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
                {% for key, group in sections %}
                    {% set section = group.case %}
                    {% set rows = group.rows %}
                    <div class="rounded-lg border border-slate-700/50 bg-slate-800/40 p-5" id="{{ key }}">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-sm font-semibold text-white">{{ section.label }}</p>
                                <p class="mt-0.5 font-mono text-[11px] text-slate-500">{{ key }}</p>
                            </div>
                            <a href="{{ path("app_admin_content_item_new", {section: key}) }}"
                               class="shrink-0 rounded-md border border-slate-700 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:border-slate-500 hover:text-white">
                                Add row
                            </a>
                        </div>

                        <p class="mt-3 text-xs text-slate-500">{{ section.fieldHint }}</p>

                        {% if rows is empty %}
                            <p class="mt-4 rounded border border-dashed border-slate-700 px-4 py-6 text-center text-xs text-slate-500">
                                No rows yet.
                            </p>
                        {% else %}
                            <ul class="mt-4 space-y-2">
                                {% for row in rows %}
                                    <li class="flex items-center justify-between gap-4 rounded border border-slate-700/50 bg-[#0F172A] px-4 py-2.5">
                                        <span class="min-w-0">
                                            <span class="block truncate text-sm text-slate-200">{{ row.title|default(row.body|default("(untitled)"))|slice(0, 80) }}</span>
                                            <span class="block font-mono text-[10px] text-slate-500">order {{ row.sortOrder }}</span>
                                        </span>
                                        <a href="{{ path("app_admin_content_item_edit", {id: row.id}) }}"
                                           class="shrink-0 text-xs font-semibold text-sky-400 transition-colors hover:text-sky-300">Edit</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </section>
    </main>
</body>
</html>
