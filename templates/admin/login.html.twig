{% extends "base.html.twig" %}

{% block title %}Sign in · GDC Command Centre{% endblock %}

{% block body %}
    <div class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center py-16">
        <div class="rounded-lg border border-slate-800/10 bg-white p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-regal">Restricted area</p>
            <h1 class="mt-3 text-2xl font-bold tracking-tight text-navy">Command centre sign-in</h1>
            <p class="mt-2 text-sm text-slate-600">
                Access to internal telemetry requires an authorized GDC administrator credential.
            </p>

            {% if error %}
                <div role="alert" class="mt-6 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">
                    {{ error.messageKey|trans(error.messageData, "security") }}
                </div>
            {% endif %}

            <form method="post" class="mt-6 space-y-5" novalidate>
                <div>
                    <label for="username" class="block text-sm font-medium text-navy">Email</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus
                           autocomplete="username"
                           class="mt-1 block w-full rounded-md border border-slate-800/20 bg-white px-3 py-2 text-sm text-navy focus:border-regal focus:outline-none focus:ring-1 focus:ring-regal">
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-navy">Password</label>
                    <input type="password" id="password" name="_password" required autocomplete="current-password"
                           class="mt-1 block w-full rounded-md border border-slate-800/20 bg-white px-3 py-2 text-sm text-navy focus:border-regal focus:outline-none focus:ring-1 focus:ring-regal">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token("authenticate") }}">

                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-md bg-regal px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-navy focus:outline-none focus-visible:ring-2 focus-visible:ring-regal focus-visible:ring-offset-2">
                    Sign in
                </button>
            </form>
        </div>

        <p class="mt-6 text-center text-xs text-slate-500">
            All authentication attempts against this endpoint are logged.
        </p>
    </div>
{% endblock %}
