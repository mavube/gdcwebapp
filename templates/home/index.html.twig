{% extends 'base.html.twig' %}

{% block title %}Global Dynamics Consulting | Executive Development{% endblock %}

{% block body %}
    <section class="grid grid-cols-1 gap-12 pt-16 pb-20 md:grid-cols-5 md:gap-16">
        <div class="md:col-span-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-regal">
                Global Dynamics Consulting &bull; Executive Development
            </p>
            <h1 class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-navy md:text-6xl">
                Certification &amp; Strategy for Delivery Leaders
            </h1>
            <p class="mt-8 max-w-3xl text-lg leading-relaxed text-slate-600">
                We build certified programme leadership inside complex organisations, combining
                credential-bearing training with automation that makes the discipline stick.
            </p>
        </div>
        <aside class="md:col-span-2" aria-label="Practice summary">
            <dl class="divide-y divide-slate-800/10 border-y border-slate-800/10">
                <div class="flex items-baseline justify-between py-4">
                    <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Active programmes</dt>
                    <dd class="text-sm font-semibold text-navy">{{ programs|length }}</dd>
                </div>
                <div class="flex items-baseline justify-between py-4">
                    <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Delivery</dt>
                    <dd class="text-sm font-semibold text-navy">Instructor-led</dd>
                </div>
                <div class="flex items-baseline justify-between py-4">
                    <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Response time</dt>
                    <dd class="text-sm font-semibold text-navy">1 business day</dd>
                </div>
            </dl>
        </aside>
    </section>

    {% include '_partials/_bento.html.twig' only %}

    <section class="border-t border-slate-800/10 pt-16 pb-24" id="catalogue">
        <h2 class="text-2xl font-bold tracking-tight text-navy md:text-3xl">Programme catalogue</h2>

        {% if programs is empty %}
            <p class="mt-6 max-w-3xl text-slate-600">
                Programme details are being finalised. Please request a consultation and we will
                send the full syllabus directly.
            </p>
        {% else %}
            <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
                {% for program in programs %}
                    <article class="flex flex-col rounded-lg border border-slate-800/10 bg-white p-6 transition-colors hover:border-regal">
                        <p class="text-xs font-semibold uppercase tracking-wider text-regal">{{ program.duration }}</p>
                        <h3 class="mt-3 text-lg font-semibold tracking-tight text-navy">{{ program.title }}</h3>
                        <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{{ program.tagline }}</p>
                        <a href="{{ path('app_training_show', {slug: program.slug}) }}"
                           class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-regal tracking-normal transition-[letter-spacing] hover:tracking-wide focus:outline-none focus-visible:ring-2 focus-visible:ring-regal focus-visible:ring-offset-2">
                            View programme <span aria-hidden="true">&rarr;</span>
                        </a>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
