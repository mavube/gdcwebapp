{% extends 'base.html.twig' %}

{% block title %}Global Dynamics Consulting | Executive Development{% endblock %}

{% block body %}
    <section class="ui-section grid grid-cols-1 gap-12 md:grid-cols-5 md:gap-16">
        <div class="md:col-span-3">
            <p class="ui-type-label">
                Global Dynamics Consulting &bull; Executive Development
            </p>
            <h1 class="ui-type-display mt-6">
                Certification &amp; Strategy for Delivery Leaders
            </h1>
            <p class="ui-type-body mt-8 max-w-measure text-lg">
                We build certified programme leadership inside complex organisations, combining
                credential-bearing training with automation that makes the discipline stick.
            </p>
            <div class="mt-10">
                <a href="#catalogue" class="ui-button ui-button-primary">View the catalogue</a>
            </div>
        </div>
        <aside class="md:col-span-2" aria-label="Practice summary">
            <dl class="divide-y divide-navy/10 border-y border-navy/10">
                <div class="flex items-baseline justify-between py-5">
                    <dt class="ui-type-label text-muted">Active programmes</dt>
                    <dd class="font-heading text-sm font-bold text-navy">{{ programs|length }}</dd>
                </div>
                <div class="flex items-baseline justify-between py-5">
                    <dt class="ui-type-label text-muted">Delivery</dt>
                    <dd class="font-heading text-sm font-bold text-navy">Instructor-led</dd>
                </div>
                <div class="flex items-baseline justify-between py-5">
                    <dt class="ui-type-label text-muted">Response time</dt>
                    <dd class="font-heading text-sm font-bold text-navy">1 business day</dd>
                </div>
            </dl>
        </aside>
    </section>

    {% include '_partials/_bento.html.twig' only %}

    <section class="ui-section border-t border-navy/10" id="catalogue">
        <h2 class="ui-type-headline">Programme catalogue</h2>

        {% if programs is empty %}
            <p class="ui-type-body mt-6 max-w-measure">
                Programme details are being finalised. Please request a consultation and we will
                send the full syllabus directly.
            </p>
        {% else %}
            <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
                {% for program in programs %}
                    <article class="ui-card ui-card-interactive">
                        <p class="ui-type-label">{{ program.duration }}</p>
                        <h3 class="ui-type-title mt-4">{{ program.title }}</h3>
                        <p class="ui-type-body mt-3 flex-1 text-sm">{{ program.tagline }}</p>
                        <a href="{{ path('app_training_show', {slug: program.slug}) }}"
                           class="mt-6 inline-flex items-center gap-1 font-heading text-sm font-semibold text-regal transition-[letter-spacing] hover:tracking-wide focus:outline-none focus-visible:ring-2 focus-visible:ring-regal focus-visible:ring-offset-2">
                            View programme <span aria-hidden="true">&rarr;</span>
                        </a>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
