{% extends 'base.html.twig' %}

{% block title %}{{ program.title }} | Global Dynamics Consulting{% endblock %}

{% block body %}
    {% include '_partials/_hero.html.twig' with {program: program, blocks: blocks} only %}

    {% include '_partials/_bento.html.twig' with {blocks: blocks, items: items} only %}

    {# Programme detail block #}
    <section class="ui-section border-t border-brand-ink/10" id="programmes">
        <p class="ui-type-label">Programme overview</p>
        <h2 class="ui-type-headline mt-4">What this programme covers</h2>
        {# Autoescaped. Never apply |raw to this field: it is user/admin-supplied text. #}
        <div class="ui-type-body mt-6 max-w-measure whitespace-pre-line">{{ program.description }}</div>
    </section>

    {% include '_partials/_inquiry.html.twig' with {inquiryForm: inquiryForm, blocks: blocks} only %}
{% endblock %}
