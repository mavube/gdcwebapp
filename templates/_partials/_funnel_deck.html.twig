{#
    Conversion deck: the asynchronous slide-out funnel.

    Rendered once per page and controlled entirely by assets/funnel.js. Every
    network call returns JSON, so opening, validating and committing a lead
    never triggers a navigation event.
#}

{# ---- Overlay: dims the site behind the deck and locks scroll while open ---- #}
<div id="funnel-overlay"
     class="fixed inset-0 z-40 hidden bg-navy/40 backdrop-blur-sm"
     aria-hidden="true"></div>

{# ---- The panel: settles at 512px from the right edge ---- #}
<aside id="funnel-deck"
       role="dialog"
       aria-modal="true"
       aria-labelledby="funnel-title"
       aria-hidden="true"
       data-csrf-token="{{ csrf_token("funnel") }}"
       data-validate-url="{{ path("app_funnel_validate") }}"
       data-submit-url="{{ path("app_funnel_submit") }}"
       class="max-w-lg w-full h-full fixed inset-y-0 right-0 z-50 transform translate-x-full
              flex flex-col bg-canvas shadow-strong transition-transform duration-300 ease-out">

    {# ---- Deck header ---- #}
    <div class="flex items-center justify-between border-b border-navy/10 px-7 py-6">
        <div>
            <p class="ui-type-label">GDC Briefing Request</p>
            <p id="funnel-step-label" class="mt-2 text-sm text-muted">Step 1 of 2 · Select your objective</p>
        </div>
        <button type="button" id="funnel-close" aria-label="Close request panel"
                class="rounded-full p-2 text-muted transition-colors hover:bg-navy/5 hover:text-navy focus:outline-none focus-visible:ring-2 focus-visible:ring-regal">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
        </button>
    </div>

    {# ---- Scrollable deck body ---- #}
    <div class="flex-1 overflow-y-auto px-7 py-8">

        <div id="funnel-alert" role="alert"
             class="mb-6 hidden rounded-field border border-danger/30 bg-danger/5 px-5 py-4 text-sm text-danger"></div>

        {# ================= STEP 1: Intent matrix ================= #}
        <section id="funnel-step-1" data-step="1">
            <h2 id="funnel-title" class="ui-type-title">
                How can GDC support your organization?
            </h2>
            <p class="ui-type-body mt-3 text-sm">
                Choose the engagement track that matches your immediate priority.
            </p>

            <fieldset class="mt-7 space-y-3">
                <legend class="sr-only">Engagement track</legend>

                {% set tiers = [
                    {value: "value-blueprint", title: "Enterprise Process Optimization & Strategy Briefing", note: "ValueBlueprint™ Alignment"},
                    {value: "credentialing", title: "Professional Credentialing Track", note: "PMP / CAPM / MS Project Programs"},
                    {value: "mentorship", title: "Executive Mentorship Framework Enrollment", note: "PMPCitizen™ Lifecycle Support"}
                ] %}

                {% for tier in tiers %}
                    <label class="flex cursor-pointer items-start gap-4 rounded-field border border-navy/15 p-5 transition-colors hover:border-regal has-[:checked]:border-regal has-[:checked]:bg-regal/5">
                        <input type="radio" name="intentTier" value="{{ tier.value }}" data-funnel-field="intentTier"
                               class="mt-1 h-4 w-4 shrink-0 border-taupe text-regal focus:ring-regal">
                        <span class="min-w-0">
                            <span class="block font-heading text-sm font-semibold text-navy">{{ tier.title }}</span>
                            <span class="mt-2 block text-xs tracking-wide text-muted">{{ tier.note }}</span>
                        </span>
                    </label>
                {% endfor %}
            </fieldset>

            <button type="button" id="funnel-to-step-2" disabled
                    class="ui-button ui-button-primary mt-8 w-full">
                Continue
            </button>
        </section>

        {# ================= STEP 2: Demographic payload ================= #}
        <section id="funnel-step-2" data-step="2" class="hidden">
            <h2 class="ui-type-title">
                Where should we send your briefing confirmation?
            </h2>
            <p class="ui-type-body mt-3 text-sm">
                All fields are required. We reply to corporate addresses only.
            </p>

            <div class="mt-7 space-y-5">
                {% set fields = [
                    {name: "fullName", label: "Full name", type: "text", autocomplete: "name", placeholder: "Jane Doe"},
                    {name: "companyName", label: "Corporate name", type: "text", autocomplete: "organization", placeholder: "Acme Industries Ltd"},
                    {name: "email", label: "Corporate email address", type: "email", autocomplete: "email", placeholder: "jane.doe@acme.com"},
                    {name: "organizationScope", label: "Organization scope", type: "text", autocomplete: "off", placeholder: "e.g. 500-1000 staff, 3 regions"}
                ] %}

                {% for f in fields %}
                    <div data-funnel-group="{{ f.name }}">
                        <label for="funnel-{{ f.name }}" class="ui-form-label">{{ f.label }}</label>
                        <input type="{{ f.type }}" id="funnel-{{ f.name }}" name="{{ f.name }}"
                               data-funnel-field="{{ f.name }}" autocomplete="{{ f.autocomplete }}"
                               placeholder="{{ f.placeholder }}"
                               aria-describedby="funnel-{{ f.name }}-error"
                               class="ui-form-input border-slate-800/20">
                        <p id="funnel-{{ f.name }}-error" data-funnel-error
                           class="mt-1 hidden text-xs text-danger"></p>
                    </div>
                {% endfor %}

                <div data-funnel-group="phone">
                    <label for="funnel-phone" class="ui-form-label">Active mobile point-of-contact</label>
                    <input type="tel" id="funnel-phone" name="phone" data-funnel-field="phone"
                           autocomplete="tel" placeholder="+254 700 000 000"
                           aria-describedby="funnel-phone-error"
                           class="ui-form-input border-slate-800/20">
                    <p id="funnel-phone-error" data-funnel-error class="mt-1 hidden text-xs text-danger"></p>
                </div>
            </div>

            <div class="mt-8 flex items-center gap-3">
                <button type="button" id="funnel-back"
                        class="ui-button ui-button-outline">
                    Back
                </button>
                <button type="button" id="funnel-submit"
                        class="ui-button ui-button-primary flex-1">
                    Submit request
                </button>
            </div>
        </section>

        {# ================= STEP 3: Confirmation ================= #}
        <section id="funnel-step-3" data-step="3" class="hidden">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-regal/10">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 13l4 4L19 7" stroke="#b98b6e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>

            <h2 id="funnel-confirm-heading" class="ui-type-title mt-7"></h2>
            <p id="funnel-confirm-body" class="ui-type-body mt-4 text-sm"></p>

            <dl class="mt-7 rounded-field border border-navy/10 bg-cream px-5 py-4">
                <div class="flex items-center justify-between py-1.5">
                    <dt class="text-xs tracking-wide text-muted">Reference</dt>
                    <dd id="funnel-confirm-ref" class="font-heading text-sm font-semibold text-navy"></dd>
                </div>
                <div class="flex items-center justify-between py-1.5">
                    <dt class="text-xs tracking-wide text-muted">Engagement track</dt>
                    <dd id="funnel-confirm-tier" class="font-heading text-sm font-semibold text-navy"></dd>
                </div>
            </dl>

            {# Immediate digital calendar booking link, built client-side so the
               panel needs no external request until the prospect clicks. #}
            <a id="funnel-calendar" href="#" target="_blank" rel="noopener noreferrer"
               class="ui-button ui-button-primary mt-7 w-full">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M2 6.5h12M5.5 2v2.5M10.5 2v2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Add the briefing to your calendar
            </a>

            <button type="button" id="funnel-done"
                    class="ui-button ui-button-outline mt-3 w-full">
                Close
            </button>
        </section>
    </div>
</aside>
