{#
    Questions.

    An accordion built on <details>/<summary> rather than a scripted widget: it
    is keyboard operable, reachable by find-in-page, and works with JavaScript
    disabled. The first entry is open so the section never reads as a wall of
    closed bars.

    Questions and answers come from ContentItem ("home.faq").
#}
{% set heading = blocks['home.faq']|default(null) %}
{% set faq = items['home.faq']|default([]) %}

{% if faq|length > 0 %}
    <section class="ui-section" id="faq">
        <div class="ui-container">
            <div class="ui-section-head ui-section-head-centered">
                {% if heading and heading.eyebrow %}
                    <p class="ui-type-label">{{ heading.eyebrow }}</p>
                {% endif %}
                {% if heading and heading.heading %}
                    <h2 class="ui-section-title">{{ heading.heading }}</h2>
                {% endif %}
                {% if heading and heading.body %}
                    <p class="ui-type-lead">{{ heading.body }}</p>
                {% endif %}
            </div>

            <div class="mx-auto mt-12 w-full max-w-3xl space-y-3">
                {% for entry in faq %}
                    <details class="ui-disclosure"{% if loop.first %} open{% endif %}>
                        <summary>
                            <h3 class="ui-disclosure-question">{{ entry.title }}</h3>
                            <span class="ui-disclosure-marker" aria-hidden="true">
                                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/>
                                </svg>
                            </span>
                        </summary>
                        {% if entry.body %}
                            <div class="px-6 pb-6">
                                <p class="ui-type-body max-w-2xl">{{ entry.body }}</p>
                            </div>
                        {% endif %}
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}
