{# Bento card. One shared hover contract (.ui-card-interactive) rather than
   per-card animation, so every interactive card behaves identically. #}
<article class="ui-card ui-card-interactive {{ span }}">
    <p class="ui-type-label">{{ eyebrow }}</p>
    <h3 class="ui-type-title mt-4">{{ title }}</h3>
    <p class="ui-type-body mt-3 flex-1 text-sm">{{ body }}</p>
    <a href="{{ href }}"
       class="mt-6 inline-flex items-center gap-1 font-heading text-sm font-semibold text-brand transition-[letter-spacing] hover:tracking-wide focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">
        {{ cta }} <span aria-hidden="true">&rarr;</span>
    </a>
</article>
