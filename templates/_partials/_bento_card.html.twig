{# Bento card. Hover signal is border colour + CTA tracking ONLY: no lift, scale or shadow. #}
<article class="flex flex-col rounded-lg border border-slate-800/10 bg-white p-6 transition-colors hover:border-regal {{ span }}">
    <p class="text-xs font-semibold uppercase tracking-wider text-regal">{{ eyebrow }}</p>
    <h3 class="mt-3 text-lg font-semibold tracking-tight text-navy">{{ title }}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{{ body }}</p>
    <a href="{{ href }}"
       class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-regal tracking-normal transition-[letter-spacing] hover:tracking-wide focus:outline-none focus-visible:ring-2 focus-visible:ring-regal focus-visible:ring-offset-2">
        {{ cta }} <span aria-hidden="true">&rarr;</span>
    </a>
</article>
