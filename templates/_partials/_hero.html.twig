{# ---- Programme hero: 60/40 split, facts on the right ---- #}
{# The framing line and the trailing phrase of the headline are editable. The
   programme's own title comes from its record, so it is not duplicated here. #}
{% set hero = blocks['training.hero']|default(null) %}

<section class="ui-section grid grid-cols-1 gap-12 md:grid-cols-5 md:gap-16">
    {# Left: 60% text column (3 of 5) ---- #}
    <div class="md:col-span-3">
        {% if hero and hero.eyebrow %}
            <p class="ui-type-label">{{ hero.eyebrow }}</p>
        {% endif %}
        <h1 class="ui-type-display mt-6">
            {{ program.title }}{% if hero and hero.headingAccent %} <span class="text-accent">{{ hero.headingAccent }}</span>{% endif %}
        </h1>
        <p class="ui-type-body mt-8 max-w-measure text-lg">
            {{ program.tagline }}
        </p>
    </div>

    {# Right: 40% telemetry widget (2 of 5) ---- #}
    <aside class="md:col-span-2" aria-label="Programme details">
        <dl class="divide-y divide-brand-ink/10 border-y border-brand-ink/10">
            <div class="flex items-baseline justify-between py-5">
                <dt class="ui-type-label text-muted">Total duration</dt>
                <dd class="font-heading text-sm font-bold text-brand-ink">{{ program.duration }}</dd>
            </div>
            <div class="flex items-baseline justify-between py-5">
                <dt class="ui-type-label text-muted">PDU accumulation</dt>
                <dd class="font-heading text-sm font-bold text-brand-ink">{{ program.pduCount }} PDUs</dd>
            </div>
            <div class="flex items-baseline justify-between py-5">
                <dt class="ui-type-label text-muted">Delivery method</dt>
                <dd class="font-heading text-sm font-bold text-brand-ink">{{ program.deliveryMethod }}</dd>
            </div>
        </dl>
    </aside>
</section>
