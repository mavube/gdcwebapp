{# ---- 2. Universal Executive Hero: 60/40 asymmetric split ---- #}
<section class="ui-section grid grid-cols-1 gap-12 md:grid-cols-5 md:gap-16">
    {# Left: 60% text column (3 of 5) ---- #}
    <div class="md:col-span-3">
        <p class="ui-type-label">
            Global Dynamics Consulting &bull; Executive Development
        </p>
        <h1 class="ui-type-display mt-6">
            {{ program.title }} Certification &amp; Strategy
        </h1>
        <p class="ui-type-body mt-8 max-w-measure text-lg">
            {{ program.tagline }}
        </p>
    </div>

    {# Right: 40% telemetry widget (2 of 5) ---- #}
    <aside class="md:col-span-2" aria-label="Programme details">
        <dl class="divide-y divide-navy/10 border-y border-navy/10">
            <div class="flex items-baseline justify-between py-5">
                <dt class="ui-type-label text-muted">Total duration</dt>
                <dd class="font-heading text-sm font-bold text-navy">{{ program.duration }}</dd>
            </div>
            <div class="flex items-baseline justify-between py-5">
                <dt class="ui-type-label text-muted">PDU accumulation</dt>
                <dd class="font-heading text-sm font-bold text-navy">{{ program.pduCount }} PDUs</dd>
            </div>
            <div class="flex items-baseline justify-between py-5">
                <dt class="ui-type-label text-muted">Delivery method</dt>
                <dd class="font-heading text-sm font-bold text-navy">{{ program.deliveryMethod }}</dd>
            </div>
        </dl>
    </aside>
</section>
