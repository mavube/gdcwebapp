{# ---- 4. Inquiry module: the conversion surface ---- #}
<section class="ui-section border-t border-brand-ink/10" id="inquiry">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-5 md:gap-16">
        <div class="md:col-span-2">
            <p class="ui-type-label">Next step</p>
            <h2 class="ui-type-headline mt-4">
                Request a quotation or book a meeting
            </h2>
            <p class="ui-type-body mt-5 max-w-measure">
                Tell us what your team needs. A consultant will respond within one business day.
            </p>
        </div>

        <div class="md:col-span-3">
            {% if inquiryForm is defined %}
                {{ form_start(inquiryForm, {attr: {class: 'space-y-6', novalidate: 'novalidate'}}) }}

                    {% if inquiryForm.vars.submitted and not inquiryForm.vars.valid %}
                        <div role="alert" class="rounded-field border border-danger/30 bg-danger/5 px-5 py-4 text-sm text-danger">
                            Please correct the highlighted fields and try again.
                        </div>
                    {% endif %}

                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        {% for field in [inquiryForm.fullName, inquiryForm.companyName] %}
                            <div>
                                {{ form_label(field, null, {label_attr: {class: 'ui-form-label'}}) }}
                                {{ form_widget(field, {attr: {class: 'ui-form-input'}}) }}
                                {{ form_errors(field, {attr: {class: 'mt-1 text-xs text-danger'}}) }}
                            </div>
                        {% endfor %}
                    </div>

                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        {% for field in [inquiryForm.email, inquiryForm.phone] %}
                            <div>
                                {{ form_label(field, null, {label_attr: {class: 'ui-form-label'}}) }}
                                {{ form_widget(field, {attr: {class: 'ui-form-input'}}) }}
                                {{ form_errors(field, {attr: {class: 'mt-1 text-xs text-danger'}}) }}
                            </div>
                        {% endfor %}
                    </div>

                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        {% for field in [inquiryForm.inquiryType, inquiryForm.preferredDate] %}
                            <div>
                                {{ form_label(field, null, {label_attr: {class: 'ui-form-label'}}) }}
                                {{ form_widget(field, {attr: {class: 'ui-form-input'}}) }}
                                {{ form_errors(field, {attr: {class: 'mt-1 text-xs text-danger'}}) }}
                            </div>
                        {% endfor %}
                    </div>

                    {{ form_row(inquiryForm.trainingProgram, {label_attr: {class: 'ui-form-label'}, attr: {class: 'ui-form-input'}}) }}

                    <div>
                        <button type="submit" class="ui-button ui-button-primary">
                            Send request
                        </button>
                    </div>

                    {# CSRF token is rendered automatically by form_start; never disable it. #}
                    {{ form_rest(inquiryForm) }}
                {{ form_end(inquiryForm, {render_rest: false}) }}
            {% endif %}
        </div>
    </div>
</section>
